# OWLCMS Integration Configuration

# Update key for authenticating requests from OWLCMS
# This must match the updateKey configured in OWLCMS
OWLCMS_UPDATEKEY=development-key

# Optional: OWLCMS address used by the same-origin proxy. When omitted, the
# Tracker derives it from the authenticated OWLCMS WebSocket connection.
# OWLCMS_URL=http://127.0.0.1:8080

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Server port (defaults to SvelteKit default)
# PORT=3000