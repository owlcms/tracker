  "options": [
    {
      "key": "replaysBaseUrl",
      "default": "http://127.0.0.1:8091"
    },
    {
      "key": "replayToken",
      "default": "enc:v1:ab9f7210:z7JyAIF17BMLklU/WE8lzPYC+laabuna7gAf+7/BYWczhJENBqb2Qg=="
    },
    {
      "key": "enableSlowMotion",
      "default": false
    }
  ]
}
